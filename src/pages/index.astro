<script>
	import {
		getContributionData,
		getDuelWinner,
		type ContributionData,
		type DailyContribution,
	} from '../lib/duel';

	const form = document.querySelector<HTMLFormElement>('#duel-form');
	const player1Input = document.querySelector<HTMLInputElement>('#player-1');
	const player2Input = document.querySelector<HTMLInputElement>('#player-2');
	const results = document.querySelector<HTMLElement>('#results');
	const submitButton = form?.querySelector<HTMLButtonElement>(
		'button[type="submit"]',
	);
	const numberFormat = new Intl.NumberFormat('pl-PL');
	const dateFormat = new Intl.DateTimeFormat('pl-PL', {
		day: 'numeric',
		month: 'short',
		year: 'numeric',
		timeZone: 'UTC',
	});

	if (form && player1Input && player2Input && results && submitButton) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const player1 = player1Input.value.trim();
			const player2 = player2Input.value.trim();

			if (!player1 || !player2) {
				player1Input.toggleAttribute('aria-invalid', !player1);
				player2Input.toggleAttribute('aria-invalid', !player2);
				showMessage('Podaj nazwy obu graczy.');
				(player1 ? player2Input : player1Input).focus();
				return;
			}

			player1Input.removeAttribute('aria-invalid');
			player2Input.removeAttribute('aria-invalid');
			submitButton.disabled = true;
			results.setAttribute('aria-busy', 'true');
			showMessage('Pobieranie danych graczy…');

			try {
				const [contributions1, contributions2] = await Promise.all([
					loadContributions(player1),
					loadContributions(player2),
				]);
				showDuelResult(player1, contributions1, player2, contributions2);
			} catch (error) {
				showMessage(
					error instanceof Error
						? error.message
						: 'Nie udało się rozstrzygnąć pojedynku. Spróbuj ponownie.',
				);
			} finally {
				submitButton.disabled = false;
				results.removeAttribute('aria-busy');
			}
		});
	}

	async function loadContributions(username: string): Promise<ContributionData> {
		let response: Response;
		try {
			response = await fetch(
				`/api/contributions/${encodeURIComponent(username)}`,
			);
		} catch {
			throw new Error('Nie udało się połączyć z serwerem. Spróbuj ponownie.');
		}

		if (!response.ok) {
			if (response.status === 400) {
				throw new Error('Nazwa użytkownika GitHuba jest nieprawidłowa.');
			}
			if (response.status === 404) {
				throw new Error('Nie znaleziono użytkownika GitHuba.');
			}
			if (response.status === 504) {
				throw new Error('GitHub nie odpowiedział na czas. Spróbuj ponownie.');
			}
			throw new Error('Nie udało się pobrać danych z GitHuba. Spróbuj ponownie.');
		}

		let payload: unknown;
		try {
			payload = await response.json();
		} catch {
			throw new Error('Otrzymano nieprawidłowe dane z GitHuba.');
		}

		return getContributionData(payload);
	}

	function showDuelResult(
		player1: string,
		contributions1: ContributionData,
		player2: string,
		contributions2: ContributionData,
	) {
		const heading = document.createElement('h2');
		const duel = document.createElement('div');
		const winner = getDuelWinner(
			contributions1.total_contributions,
			contributions2.total_contributions,
		);

		if (winner === 'draw') {
			heading.textContent = 'Remis!';
		} else {
			heading.textContent = `Zwycięża ${winner === 'player1' ? player1 : player2}!`;
		}

		duel.className = 'duel';
		duel.append(
			createGantry(),
			createPlayerCard(player1, contributions1),
			createVsBadge(),
			createPlayerCard(player2, contributions2),
		);
		results?.replaceChildren(heading, duel);
	}

	function createPlayerCard(username: string, data: ContributionData): HTMLElement {
		const card = document.createElement('article');
		const name = document.createElement('h3');
		const total = document.createElement('p');
		const dateRange = document.createElement('p');
		const gridWrap = document.createElement('div');
		const grid = document.createElement('ol');
		const days = [...data.contributions].sort((dayA, dayB) =>
			dayA.date.localeCompare(dayB.date),
		);

		card.className = 'player-card';
		name.textContent = username;
		total.className = 'player-total';
		total.textContent = formatContributionCount(data.total_contributions);
		dateRange.className = 'date-range';
		dateRange.textContent = `Zakres: ${formatDate(data.from)} – ${formatDate(data.to)}`;
		gridWrap.className = 'contribution-grid-wrap';
		grid.className = 'contribution-grid';
		grid.setAttribute('aria-label', `Wykres kontrybucji użytkownika ${username}`);

		const leadingEmptyDays = new Date(`${data.from}T00:00:00.000Z`).getUTCDay();
		for (let index = 0; index < leadingEmptyDays; index += 1) {
			const emptyDay = document.createElement('li');
			emptyDay.className = 'contribution-day empty-day';
			emptyDay.setAttribute('aria-hidden', 'true');
			grid.append(emptyDay);
		}

		for (const day of days) {
			grid.append(createContributionCell(day));
		}

		gridWrap.append(grid);
		card.append(name, total, dateRange, gridWrap);
		return card;
	}

	function createContributionCell(day: DailyContribution): HTMLLIElement {
		const cell = document.createElement('li');
		const label = `${formatDate(day.date)}: ${formatContributionCount(day.count)}`;

		cell.className = `contribution-day level-${day.level}`;
		cell.setAttribute('aria-label', label);
		cell.title = label;
		return cell;
	}

	function createVsBadge(): HTMLElement {
		const badge = document.createElement('span');
		badge.className = 'vs-badge';
		badge.textContent = 'VS';
		badge.setAttribute('aria-label', 'kontra');
		return badge;
	}

	function createGantry(): SVGSVGElement {
		const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
		svg.setAttribute('class', 'gantry-scene');
		svg.setAttribute('viewBox', '0 0 1000 500');
		svg.setAttribute('preserveAspectRatio', 'none');
		svg.setAttribute('aria-hidden', 'true');
		svg.setAttribute('focusable', 'false');

		const beam = document.createElementNS('http://www.w3.org/2000/svg', 'path');
		beam.setAttribute('class', 'gantry-beam');
		beam.setAttribute(
			'd',
			'M28 498V34H972V498 M28 62H972 M54 34V16H946V34 M28 34L88 62 M88 34L28 62 M912 34L972 62 M972 34L912 62',
		);
		svg.append(beam);

		const lattice = document.createElementNS(
			'http://www.w3.org/2000/svg',
			'path',
		);
		lattice.setAttribute('class', 'gantry-lattice');
		lattice.setAttribute(
			'd',
			'M28 104L88 164L28 224L88 284L28 344L88 404L28 464 M88 104L28 164L88 224L28 284L88 344L28 404L88 464 M912 104L972 164L912 224L972 284L912 344L972 404L912 464 M972 104L912 164L972 224L912 284L972 344L912 404L972 464 M120 62V84H880V62',
		);
		svg.append(lattice);
		return svg;
	}

	function formatDate(date: string): string {
		return dateFormat.format(new Date(`${date}T00:00:00.000Z`));
	}

	function formatContributionCount(total: number): string {
		const lastTwoDigits = total % 100;
		const lastDigit = total % 10;
		const noun =
			total === 1
				? 'kontrybucja'
				: lastDigit >= 2 && lastDigit <= 4 &&
					  (lastTwoDigits < 12 || lastTwoDigits > 14)
					? 'kontrybucje'
					: 'kontrybucji';

		return `${numberFormat.format(total)} ${noun}`;
	}

	function showMessage(message: string) {
		const paragraph = document.createElement('p');
		paragraph.textContent = message;
		results?.replaceChildren(paragraph);
	}
</script>

<style>
