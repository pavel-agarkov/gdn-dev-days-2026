		color: #1f2328;
		font-family: system-ui, sans-serif;
	}

	main {
		max-width: 60rem;
		margin: 3rem auto;
		padding: 2rem;
		border: 1px solid #d1d9e0;
		border-radius: 0.75rem;
		background: #fff;
	}

	h1,
	.intro {
		text-align: center;
	}

	h1 {
		margin: 0;
	}

